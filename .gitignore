# Python bytecode & environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.pytest_cache/

# Automated test failure diagnostic logs
tests/logs/

# Environment & secrets (CRITICAL: never commit real API keys or tokens)
.env
.env.*
!.env.example
*.pem
*.key

# Runtime databases, logs & uploaded media (keep baseline sample fixtures)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.log
nul
tmp/
.DS_Store
Thumbs.db
data/*.db
data/*.db-shm
data/*.db-wal
data/uploads/
data/reports/
data/samples/*_annotated.*
models_cache/
