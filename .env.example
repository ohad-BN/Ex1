# Core Flask & Security
CLASSPULSE_ENV=development
SECRET_KEY=dev-classpulse-hmac-secret-key-2026
DATABASE_URL=sqlite:///data/classpulse.db
ENABLE_CSRF=true
ENABLE_DEMO_SEED=false
HEADCOUNT_RETENTION_HOURS=0

# QR & Attendance Settings
QR_STEP_SECONDS=5
QR_GRACE_BUCKETS=6
HEADCOUNT_TOLERANCE=2
LATE_AFTER_MINUTES=15

# Cloudflare Tunnel (Leave empty to use zero-config Quick Tunnel *.trycloudflare.com)
TUNNEL_TOKEN=
PUBLIC_BASE_URL=

# Google AI Studio (Optional — Features 4 & 5: Video Summary & Homework Deep Review)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_PRO_MODEL=gemini-2.5-flash-lite
GEMINI_MIN_INTERVAL_SEC=1.5
