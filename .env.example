# Core Flask & Security
CLASSPULSE_ENV=development
SECRET_KEY=dev-classpulse-hmac-secret-key-change-in-prod
DATABASE_URL=sqlite:///data/classpulse.db
ENABLE_CSRF=true
ENABLE_DEMO_SEED=true
HEADCOUNT_RETENTION_HOURS=0

# QR & Attendance Settings
QR_STEP_SECONDS=5
QR_GRACE_BUCKETS=1
HEADCOUNT_TOLERANCE=2
LATE_AFTER_MINUTES=15

# Cloudflare Tunnel (Leave empty to use zero-config Quick Tunnel *.trycloudflare.com)
TUNNEL_TOKEN=
PUBLIC_BASE_URL=

# Google AI Studio (Features 4 & 5: Audio Transcription, Lecture Summary & Homework Review)
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-3.8-flash
GEMINI_MIN_INTERVAL_SEC=4.5
